# --- Project-specific user state (auto-created at runtime, never committed) ---
# The app keeps everything self-contained under segesource/, so runtime
# files appear there. We ignore them but tracked code stays committed.
segesource/gui_settings.json
segesource/segesource.log*
segesource/buff.json
segesource/single.json
segesource/priest_goat_config.json
segesource/farm_data/
segesource/narki_data/
# Catch-all in case the user runs the script from a different CWD
settings.json
gui_settings.json
buff.json
single.json
priest_goat_config.json
farm_data/
narki_data/

# --- Runtime image captures (user-generated, never committed) ---
login_images/
notification_images/
segesource/login_images/
segesource/notification_images/

# --- Native runtime artifacts (installed locally, not in repo) ---
# interception.dll comes from the Interception driver install, never committed
*.dll
*.pyd
*.exe

# --- Misc ---
*.bak
*.tmp
.tmp/
